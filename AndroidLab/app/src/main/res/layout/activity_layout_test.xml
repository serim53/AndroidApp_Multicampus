<?xml version="1.0" encoding="utf-8"?>
<!-- 뷰가 여러개 나열되어 화면을 벗어난다. 자동 스크롤 되지 않는다.
 스크롤 되어야 하는 위치는 ScrollView 로 감싼다..-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LayoutTestActivity">

<!--    ScrollView 하위에는 하나의 뷰만 추가 가능.. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:adjustViewBounds="true"
                android:src="@drawable/main_bg_1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="연말연시 특별 할인 이벤트 \n 최대 20% 할인"
                android:textColor="#FFFFFF"
                android:textSize="20dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="50dp"/>

        </FrameLayout>
<!--        xml 에서 사이즈를 명시할 때는 단위 생략 불가..
    px : 물리적인 단위..
    dp, sp(문자열 폰트 사이즈) : 논리적인 단위.. 시스템에서 폰 사이즈를 보고 적절한 px 을 계산해서 적용
    ==>폰 사이즈 호환성을 위해 가급적 논리적인 단위 지정이 권장..
 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="특가 여행지"
                android:textSize="15dp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"/>
<!--            xml 에서 값을 지정할 때 @는 리소스이다.
앱의 리소스 @drawable/a
platform 에서도 모든 앱이 사용가능한 리소스(특히 아이콘 이미지) 제공한다.
platform 리소스는. @android:drawable/a -->
            <Button
                android:id="@+id/main_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="특가 여행지 보기"
                android:layout_alignParentRight="true"
                android:layout_marginRight="16dp"
                android:layout_alignBaseline="@id/main_title"
                android:backgroundTint="#3899DD"
                android:drawableLeft="@android:drawable/arrow_down_float"/>

        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:columnCount="2">
<!--
    layout xml 에 뷰 등록할 때 생략 부가한 필수 속성은 layout_width, layout_height
    GridLayout 하위에 추가된 뷰는 사이즈가 기본 wrap_content 가 적용되어 width, height 생략 가능
    개발자가 지정한다면 match_parent 는 적용되지 않는다. 사이즈로 지정하는 것은 적용된다..
    폰 사이즈 호환성을 위해서 GridLayout 하위의 사이즈를 0으로 지정하고 weight 로 사이즈를 결정하게 하겠다.
    cardCornerRadius : 둥근 사각형 카드..
    cardElevation : 위로 올라온 듯한. 그림자 효과 때문에..

    여백
    margin : 뷰와 뷰 사이의 여백.
    padding :  특정 뷰 테두리와 그 안의 컨텐츠간의 여백..
-->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:maxWidth="150dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/main_swiss"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스위스"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 20% 할인"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:maxWidth="150dp"
                        android:src="@drawable/main_australia" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="호주" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 10% 할인" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:maxWidth="150dp"
                        android:src="@drawable/main_georgia" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="조지아" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 20% 할인" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:maxWidth="150dp"
                        android:src="@drawable/main_mongolia" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="몽골" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 20% 할인" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:maxWidth="150dp"
                        android:src="@drawable/main_nepal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="하와이" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 15% 할인" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:maxWidth="150dp"
                        android:src="@drawable/main_hawaii" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="하와이" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 5% 할인" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>



    </LinearLayout>

</ScrollView>